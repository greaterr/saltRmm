interface: 0.0.0.0
file_recv: True
publish_port: 4505
ret_port: 4506

log_level: info
log_level_logfile: info
log_file: /var/log/salt/master

file_roots:
  base:
    - /srv/salt

pillar_roots:
  base:
    - /srv/pillar

auto_accept: True

# Alcali: job storage
keep_jobs: 0
event_return: [alcali]
master_job_cache: alcali

# Alcali: MySQL returner
mysql.host: 'db'
mysql.user: 'alcali'
mysql.pass: 'alcali'
mysql.db: 'salt'
mysql.port: 3306

# Alcali: auth module
eauth_acl_module: alcali
keep_acl_in_token: true
auth_dirs: [/srv/salt/auth]

# Alcali: external auth via Django JWT
external_auth:
  rest:
    ^url: http://alcali-web:8000/api/token/verify/
    admin:
      - '.*'
      - '@runner'
      - '@wheel'
      - '@jobs'
  alcali:
    admin:
      - '.*'
      - '@local'
      - '@runner'
      - '@wheel'
      - '@jobs'

# REST API (salt-api)
rest_cherrypy:
  port: 8000
  ssl_crt: /etc/salt/ssl/macbook-pro-timur.local.crt
  ssl_key: /etc/salt/ssl/macbook-pro-timur.local.key

netapi_enable_clients:
  - local
  - local_async
  - local_batch
  - local_subset
  - runner
  - runner_async
  - ssh
  - wheel
  - wheel_async
