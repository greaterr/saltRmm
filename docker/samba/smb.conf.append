# Security hardening
ldap server require strong auth = Yes
tls enabled = yes
tls keyfile = /usr/local/samba/private/tls/key.pem
tls certfile = /usr/local/samba/private/tls/cert.pem
tls cafile = /usr/local/samba/private/tls/ca.pem
tls verify peer = no_check

# Disable old/insecure protocols
ntlm auth = ntlmv2-only
lanman auth = no
server min protocol = SMB2

# Logging
log level = 1
log file = /usr/local/samba/var/log/samba/%m.log
max log size = 5000
